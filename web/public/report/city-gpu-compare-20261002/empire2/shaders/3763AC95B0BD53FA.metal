        u_xlat16_3.xy = half2(fma(input.TEXCOORD0.xz, float2(FGlobals.gFogParams[8].xy), float2(FGlobals.gFogParams[8].zw)));
        u_xlat16_38 = BnSFog_FogMaskTex.sample(BnsFog_LinearClampSampler, float2(u_xlat16_3.xy), level(0.0)).x;
        u_xlat16_38 = log2(u_xlat16_38);
        u_xlat16_38 = u_xlat16_38 * FGlobals.gFogParams[7].y;
        u_xlat16_38 = exp2(u_xlat16_38);
        u_xlat16_3.x = half(fma((-u_xlat12.x), u_xlat0.x, 1.0));
        u_xlat16_1.w = fma(u_xlat16_38, u_xlat16_3.x, u_xlat16_1.w);
        u_xlat16_1.xyz = fma(half3(u_xlat16_38), (-u_xlat16_1.xyz), u_xlat16_1.xyz);
    }
    u_xlatb0.x = half(0.0)<FGlobals._ScreenCenterFogParams0.z;
    u_xlat12.xyz = input.TEXCOORD0.yyy * UnityPerFrame.hlslcc_mtx4x4unity_MatrixVP[1].xyw;
    u_xlat12.xyz = fma(UnityPerFrame.hlslcc_mtx4x4unity_MatrixVP[0].xyw, input.TEXCOORD0.xxx, u_xlat12.xyz);
    u_xlat12.xyz = fma(UnityPerFrame.hlslcc_mtx4x4unity_MatrixVP[2].xyw, input.TEXCOORD0.zzz, u_xlat12.xyz);
    u_xlat12.xyz = u_xlat12.xyz + UnityPerFrame.hlslcc_mtx4x4unity_MatrixVP[3].xyw;
    u_xlat12.xy = u_xlat12.xy / u_xlat12.zz;
    u_xlat12.xy = fma(u_xlat12.xy, float2(0.5, 0.5), float2(0.5, 0.5));
    u_xlat16_8.xy = FGlobals._ScreenCenterFogParams1.xy + half2(0.5, 0.5);
    u_xlat12.xy = u_xlat12.xy + (-float2(u_xlat16_8.xy));
    u_xlat12.x = dot(u_xlat12.xy, u_xlat12.xy);
    u_xlat12.x = sqrt(u_xlat12.x);
    u_xlat16_38 = half(u_xlat12.x + (-float(FGlobals._ScreenCenterFogParams0.x)));
    u_xlat16_3.x = half(1.0) / FGlobals._ScreenCenterFogParams0.y;
    u_xlat16_38 = u_xlat16_38 * u_xlat16_3.x;
    u_xlat16_38 = clamp(u_xlat16_38, 0.0h, 1.0h);
    u_xlat16_3.x = fma(u_xlat16_38, half(-2.0), half(3.0));
    u_xlat16_38 = u_xlat16_38 * u_xlat16_38;
    u_xlat16_38 = fma((-u_xlat16_3.x), u_xlat16_38, half(1.0));
    u_xlat16_3.x = u_xlat16_38 * FGlobals._ScreenCenterFogParams0.z;
    u_xlat16_38 = fma((-u_xlat16_38), FGlobals._ScreenCenterFogParams0.z, half(1.0));
    u_xlat16_4.xyz = u_xlat16_1.xyz * half3(u_xlat16_38);
    u_xlat16_38 = (-u_xlat16_1.w) + half(1.0);
    u_xlat16_4.w = fma(u_xlat16_3.x, u_xlat16_38, u_xlat16_1.w);
    u_xlat16_0 = (u_xlatb0.x) ? u_xlat16_4 : u_xlat16_1;
    output.SV_TARGET0.xyz = fma(u_xlat16_2.xyz, u_xlat16_0.www, u_xlat16_0.xyz);
    output.SV_TARGET0.w = half(1.0);
    output.SV_Target1 = hlslcc_FragCoord.z;
    return output;
}
